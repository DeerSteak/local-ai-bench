#!/bin/sh
# Keeps every mirrored version string equal to config.py's VERSION (see docs/release-policy.md).
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [ -x "$root/bench-env/bin/python" ]; then
  python="$root/bench-env/bin/python"
elif [ -x "$root/bench-env/Scripts/python.exe" ]; then
  python="$root/bench-env/Scripts/python.exe"
elif command -v python3 >/dev/null 2>&1; then
  python=python3
else
  python=python
fi

"$python" -m scripts.release.version_sync || exit 1

# Type-check staged Python — see docs/release-policy.md#pyright-hook.
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.py$'; then
  if command -v pyright >/dev/null 2>&1; then
    pyright_cmd="pyright"
  else
    pyright_cmd="npx --yes pyright@1.1.411"
  fi
  if ! $pyright_cmd; then
    echo "pyright found type errors — fix them or, for a false positive only, commit with --no-verify." >&2
    exit 1
  fi
fi

# Type-check the dashboard — see docs/release-policy.md#dashboard-tsc-hook.
if git diff --cached --name-only --diff-filter=ACM | grep -q '^dashboard/src/.*\.tsx\?$'; then
  if [ -x "$root/dashboard/node_modules/.bin/tsc" ]; then
    if ! (cd "$root/dashboard" && "$root/dashboard/node_modules/.bin/tsc" --noEmit); then
      tsc_failed=1
    fi
  else
    if ! (cd "$root/dashboard" && npx --yes typescript@6.0.3 tsc --noEmit); then
      tsc_failed=1
    fi
  fi
  if [ -n "$tsc_failed" ]; then
    echo "tsc found type errors in the dashboard — fix them or, for a false positive only, commit with --no-verify." >&2
    exit 1
  fi

  # Dashboard `any` ratchet — see docs/release-policy.md#any-ratchet-hook.
  if command -v node >/dev/null 2>&1; then
    node "$root/dashboard/check_any_ratchet.mjs" || exit 1
  fi
fi
