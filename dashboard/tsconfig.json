{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Loose-start conversion (see AGENTS.md's TypeScript section) — tighten
    // these incrementally, file by file, rather than all at once.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["src", "vite.config.js"]
}
